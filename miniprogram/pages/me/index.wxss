.container {
  min-height: 100vh;
  background: #ededed;
}

.profile-section {
  background: #ffffff;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.avatar-wrap {
  display: inline-block;
}

.avatar-big {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #576b95;
  display: block;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 500;
}

.avatar-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #888;
}

.card {
  background: #ffffff;
  margin-top: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.row:active {
  background: #f5f5f5;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #1a1a1a;
}

.value-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.value {
  font-size: 30rpx;
  color: #555;
  margin-right: 8rpx;
}

.chevron {
  color: #ccc;
  font-size: 36rpx;
}

.tip {
  margin: 32rpx 32rpx 0;
  padding: 24rpx;
  background: #fff8e6;
  border-left: 6rpx solid #ffc44d;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  white-space: pre-line;
}

/* ============ 按压反馈（B） ============ */
.avatar-wrap,
.row {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.avatar-wrap:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.profile-section:active .avatar-big {
  transform: scale(0.96);
  transition: transform 0.15s ease;
}

.container {
  min-height: 100vh;
  background-color: #ededed;
  padding-bottom: 220rpx;
}

.intro {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  background: #fff8e6;
  border-left: 6rpx solid #ffc44d;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  white-space: pre-line;
}

.section-title {
  padding: 32rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: #888;
}

.card {
  background: #ffffff;
}

.required {
  color: #fa5151;
  margin-left: 4rpx;
}

.optional {
  color: #999;
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: normal;
}

.picker-value {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #1a1a1a;
}

.picker-value .placeholder {
  color: #ccc;
}

.chevron {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 8rpx;
}

/* ============ 字段块 + 标签胶囊 ============ */
.field {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 28rpx;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.field-row .field-label {
  margin-bottom: 0;
}

.field-input {
  font-size: 30rpx;
  color: #1a1a1a;
  width: 100%;
}

.field-input::placeholder {
  color: #ccc;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border: 1rpx solid #ebebeb;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #555;
  transition: all 0.15s ease;
}

.chip:active {
  transform: scale(0.95);
}

.chip-on {
  background: #e6f7ee;
  border-color: #07c160;
  color: #07c160;
  font-weight: 500;
}

.chip-add {
  color: #999;
  border-style: dashed;
}

/* ============ 底部按钮 ============ */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 48rpx;
  background: #ededed;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  border-top: 1rpx solid #e0e0e0;
}

.btn-save,
.btn-cancel {
  flex: 1;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin: 0;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-save {
  background: #07c160 !important;
  color: #ffffff !important;
  border: none;
}

.btn-save[disabled] {
  background: #95d8b1 !important;
  color: #ffffff !important;
}

.btn-cancel {
  background: #ffffff !important;
  color: #1a1a1a !important;
  border: 1rpx solid #e0e0e0 !important;
}

.btn-save:active,
.btn-cancel:active {
  transform: scale(0.97);
  opacity: 0.85;
}

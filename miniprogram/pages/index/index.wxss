.container {
  min-height: 100vh;
  background-color: #ededed;
  position: relative;
}

/* 状态块：出错 */
.state-block {
  padding: 200rpx 60rpx 60rpx;
  text-align: center;
}

/* 骨架屏 */
.sk-page {
  padding: 0;
}

.sk-me-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.sk-me-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
  margin-right: 24rpx;
}

.sk-me-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sk-me-name {
  width: 180rpx;
  height: 32rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
  border-radius: 8rpx;
}

.sk-me-sub {
  width: 240rpx;
  height: 24rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
  border-radius: 8rpx;
}

.sk-conv {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.sk-conv-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.sk-conv-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sk-conv-name {
  width: 200rpx;
  height: 32rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
  border-radius: 8rpx;
}

.sk-conv-preview {
  width: 80%;
  height: 24rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
  border-radius: 8rpx;
}

@keyframes sk-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.state-emoji {
  font-size: 100rpx;
  line-height: 1;
}

.state-text {
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #333;
}

.state-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  padding: 180rpx 60rpx 60rpx;
  text-align: center;
}

.empty-illustration {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
}

.empty-orb {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 30%, rgba(255, 196, 224, 0.6), rgba(255, 240, 245, 0.2) 60%, transparent 80%);
  border-radius: 50%;
  animation: orb-breath 3.5s ease-in-out infinite;
}

@keyframes orb-breath {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.08); opacity: 1; }
}

.empty-emoji {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  line-height: 1;
  animation: emoji-float 4s ease-in-out infinite;
}

@keyframes emoji-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.empty-title {
  margin-top: 32rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.empty-subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #888;
}

.empty-arrow {
  margin-top: 56rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #07c160;
  animation: arrow-pulse 2s ease-in-out infinite;
}

.arrow-icon {
  font-size: 32rpx;
  font-weight: bold;
}

@keyframes arrow-pulse {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(4rpx, 4rpx); }
}

/* 列表：仿微信对话样式 */
.conv-list {
  background: #ffffff;
}

.conv-list-hint {
  padding: 16rpx 32rpx;
  font-size: 22rpx;
  color: #b0b0b0;
  background: #f5f5f7;
  border-bottom: 1rpx solid #ededed;
}

.conv-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #ededed;
  background: #ffffff;
}

.conv-item:active {
  background: #f0f0f0;
}

.conv-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ff9ec7 0%, #ff7eb3 100%);
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 126, 179, 0.25);
}

.conv-avatar image {
  width: 100%;
  height: 100%;
}

.conv-avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 500;
}

.conv-content {
  flex: 1;
  min-width: 0;
}

.conv-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.conv-name {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.conv-time {
  font-size: 22rpx;
  color: #b0b0b0;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.conv-preview {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

/* 顶部"我的资料"入口 */
.me-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.me-header:active {
  background: #f5f5f5;
}

.me-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #6a8acf 0%, #576b95 100%);
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(87, 107, 149, 0.25);
}

.me-avatar image {
  width: 100%;
  height: 100%;
}

.me-avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 500;
}

.me-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.me-name {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.me-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
}

.me-chevron {
  color: #ccc;
  font-size: 40rpx;
}

/* 浮动 + 按钮 */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 60rpx;
  line-height: 108rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab:active {
  background: #06ad56;
  transform: scale(0.95);
}

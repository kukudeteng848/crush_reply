.container {
  min-height: 100vh;
  background-color: #ededed;
  padding-bottom: 220rpx;
}

.avatar-section {
  background: #ffffff;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}

.avatar-wrap {
  display: inline-block;
}

.avatar-big {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #07c160;
  display: block;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 500;
}

.avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}

.section-title {
  padding: 32rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: #888;
}

.card {
  background: #ffffff;
  margin: 0;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 96rpx;
}

.row:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  flex-shrink: 0;
}

.required {
  color: #fa5151;
  margin-left: 4rpx;
}

.optional {
  color: #999;
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: normal;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  text-align: left;
}

.picker-value {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #1a1a1a;
}

.picker-value .placeholder {
  color: #ccc;
}

.chevron {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 8rpx;
}

.tip {
  margin: 32rpx 32rpx 0;
  padding: 24rpx;
  background: #fff8e6;
  border-left: 6rpx solid #ffc44d;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  white-space: pre-line;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 48rpx;
  background: #ededed;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  border-top: 1rpx solid #e0e0e0;
}

.btn-save,
.btn-cancel {
  flex: 1;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin: 0;
}

.btn-save {
  background: #07c160 !important;
  color: #ffffff !important;
  border: none;
}

.btn-save[disabled] {
  background: #95d8b1 !important;
  color: #ffffff !important;
}

.btn-cancel {
  background: #ffffff !important;
  color: #1a1a1a !important;
  border: 1rpx solid #e0e0e0 !important;
}

/* ============ 按压反馈（B） ============ */
.btn-save,
.btn-cancel,
.avatar-wrap,
.row,
.picker-value {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-save:active,
.btn-cancel:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.avatar-wrap:active {
  transform: scale(0.95);
}

.row:active {
  background: #f7f7f7;
}

/* ============ 字段块 + 标签胶囊（V2 团购式输入） ============ */
.field {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 28rpx;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.field-row .field-label {
  margin-bottom: 0;
}

.field-input {
  font-size: 30rpx;
  color: #1a1a1a;
  width: 100%;
}

.field-input::placeholder {
  color: #ccc;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border: 1rpx solid #ebebeb;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #555;
  transition: all 0.15s ease;
}

.chip:active {
  transform: scale(0.95);
}

.chip-on {
  background: #e6f7ee;
  border-color: #07c160;
  color: #07c160;
  font-weight: 500;
}

.chip-add {
  color: #999;
  border-style: dashed;
}

/* AI 观察 textarea */
.field-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.field-textarea::placeholder {
  color: #bbb;
  font-size: 24rpx;
}

/* 认识日期：右侧 picker + 清除 */
.known-since-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.known-since-clear {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 8rpx;
}

.known-since-hint {
  padding: 0 32rpx 20rpx;
  font-size: 24rpx;
  color: #07c160;
  margin-top: -8rpx;
}

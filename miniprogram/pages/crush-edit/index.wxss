.container {
  min-height: 100vh;
  background-color: #ededed;
  padding-bottom: 220rpx;
}

.avatar-section {
  background: #ffffff;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}

.avatar-wrap {
  display: inline-block;
}

.avatar-big {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #07c160;
  display: block;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 500;
}

.avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}

.section-title {
  padding: 32rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: #888;
}

.card {
  background: #ffffff;
  margin: 0;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 96rpx;
}

.row:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  flex-shrink: 0;
}

.required {
  color: #fa5151;
  margin-left: 4rpx;
}

.optional {
  color: #999;
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: normal;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  text-align: left;
}

.picker-value {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #1a1a1a;
}

.picker-value .placeholder {
  color: #ccc;
}

.chevron {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 8rpx;
}

.tip {
  margin: 32rpx 32rpx 0;
  padding: 24rpx;
  background: #fff8e6;
  border-left: 6rpx solid #ffc44d;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  white-space: pre-line;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 48rpx;
  background: #ededed;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  border-top: 1rpx solid #e0e0e0;
}

.btn-save,
.btn-cancel {
  flex: 1;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin: 0;
}

.btn-save {
  background: #07c160 !important;
  color: #ffffff !important;
  border: none;
}

.btn-save[disabled] {
  background: #95d8b1 !important;
  color: #ffffff !important;
}

.btn-cancel {
  background: #ffffff !important;
  color: #1a1a1a !important;
  border: 1rpx solid #e0e0e0 !important;
}

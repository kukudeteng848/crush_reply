.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

/* 全屏状态 */
.full-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.state-emoji {
  font-size: 100rpx;
}

.state-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #888;
}

/* 聊天滚动区 */
.msg-area {
  flex: 1;
  padding: 24rpx 16rpx;
  box-sizing: border-box;
}

.empty-tip {
  text-align: center;
  padding: 200rpx 60rpx 0;
}

.empty-emoji {
  font-size: 120rpx;
}

.empty-text {
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #333;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.empty-hint {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #b0b0b0;
}

.msg-round {
  margin-bottom: 32rpx;
}

/* 时间标记（仿微信） */
.time-mark {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin: 24rpx 0 16rpx;
  padding: 4rpx 16rpx;
  display: inline-block;
  width: auto;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
}

/* 气泡行：左右排版 */
.bubble-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
}

.bubble-row.left {
  justify-content: flex-start;
}

.bubble-row.right {
  justify-content: flex-end;
}

/* 头像 */
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  background: #07c160;
}

.avatar-default-me {
  background: #576b95;
}

.avatar-crush {
  margin-right: 16rpx;
}

.avatar-me {
  margin-left: 16rpx;
  background: #576b95;
}

/* 气泡 */
.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-word;
  position: relative;
}

.bubble-crush {
  background: #ffffff;
  color: #1a1a1a;
}

.bubble-crush::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 24rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 8rpx 12rpx 8rpx 0;
  border-color: transparent #ffffff transparent transparent;
}

/* AI 建议卡片（右侧） */
.ai-card {
  max-width: 78%;
  background: #95ec69;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  position: relative;
}

.ai-card-error {
  background: #fff1f0;
  border: 1rpx solid #fa5151;
}

.ai-card-error::after {
  border-color: transparent transparent transparent #fff1f0;
}

.error-block {
  padding: 16rpx 0;
  text-align: center;
}

.error-text {
  font-size: 26rpx;
  color: #fa5151;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.retry-btn {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: #fa5151;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.retry-btn:active {
  opacity: 0.8;
}

.ai-card::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 24rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 8rpx 0 8rpx 12rpx;
  border-color: transparent transparent transparent #95ec69;
}

.ai-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
  margin-bottom: 12rpx;
}

.ai-label {
  font-size: 22rpx;
  color: #4a7d3a;
  font-weight: 500;
}

.ai-style {
  font-size: 22rpx;
  color: #4a7d3a;
  opacity: 0.7;
}

.suggestion {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.suggestion:last-of-type {
  border-bottom: none;
}

.suggestion-text {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
  margin-right: 16rpx;
}

.suggestion-copy {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #4a7d3a;
  flex-shrink: 0;
}

.suggestion-copy:active {
  background: rgba(255, 255, 255, 0.9);
}

.more-btn {
  margin-top: 12rpx;
  padding: 12rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #4a7d3a;
}

.more-btn:active {
  background: rgba(255, 255, 255, 0.8);
}

/* 思考中动画 */
.thinking {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.thinking-mini {
  padding: 8rpx 0;
}

.dot {
  font-size: 40rpx;
  color: #4a7d3a;
  line-height: 0.5;
  margin-right: 4rpx;
  animation: blink 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

.thinking-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #4a7d3a;
}

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

/* 底部输入栏 */
.input-bar {
  background: #f7f7f7;
  border-top: 1rpx solid #e0e0e0;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input {
  flex: 1;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  min-height: 64rpx;
}

.send-btn {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.send-btn.active {
  background: #07c160;
  color: #ffffff;
}

.send-btn.disabled {
  background: #d9d9d9;
  color: #ffffff;
}

.style-row {
  margin-top: 16rpx;
  white-space: nowrap;
  height: 80rpx;
  width: 100%;
}

.style-row-empty {
  margin-top: 16rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fa5151;
  background: #fff;
  border-radius: 8rpx;
}

.style-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  vertical-align: middle;
}

.style-pill.selected {
  border-color: #07c160;
  background: #e8f7ed;
}

.style-emoji {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.style-name {
  color: #1a1a1a;
}

.style-pill.selected .style-name {
  color: #07c160;
  font-weight: 500;
}

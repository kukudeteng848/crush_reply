.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

/* 全屏状态 */
.full-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* ============ 骨架屏（D） ============ */
.skeleton-page {
  flex: 1;
  padding: 32rpx 16rpx;
}

.sk-bubble {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 0 16rpx;
}

.sk-left {
  justify-content: flex-start;
}

.sk-right {
  justify-content: flex-end;
}

.sk-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
  flex-shrink: 0;
}

.sk-left .sk-avatar {
  margin-right: 16rpx;
}

.sk-right .sk-avatar {
  margin-left: 16rpx;
}

.sk-text {
  height: 80rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #e8e8e8 0%, #f4f4f4 50%, #e8e8e8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s infinite linear;
}

.sk-text-short {
  width: 200rpx;
}

.sk-text-medium {
  width: 280rpx;
}

.sk-text-long {
  width: 360rpx;
  height: 140rpx;
}

@keyframes sk-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.state-emoji {
  font-size: 100rpx;
}

.state-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #888;
}

/* 聊天滚动区 */
.msg-area {
  flex: 1;
  padding: 24rpx 16rpx;
  box-sizing: border-box;
}

.empty-tip {
  text-align: center;
  padding: 140rpx 60rpx 0;
}

.empty-illustration {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto;
}

.empty-orb {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 30%, rgba(149, 236, 105, 0.5), rgba(232, 247, 237, 0.2) 60%, transparent 80%);
  border-radius: 50%;
  animation: orb-breath 3.5s ease-in-out infinite;
}

@keyframes orb-breath {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.08); opacity: 1; }
}

.empty-emoji {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  line-height: 1;
  animation: emoji-float 4s ease-in-out infinite;
}

@keyframes emoji-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

.empty-text {
  margin-top: 32rpx;
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.empty-sub-block {
  margin-top: 32rpx;
  display: inline-block;
  text-align: left;
  background: rgba(255, 255, 255, 0.6);
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
}

.empty-sub-line {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
}

.empty-hint {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: #b0b0b0;
}

.msg-round {
  margin-bottom: 32rpx;
  animation: msg-slide-in 0.35s ease-out both;
}

@keyframes msg-slide-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 时间标记（仿微信） */
.time-mark {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin: 24rpx 0 16rpx;
  padding: 4rpx 16rpx;
  display: inline-block;
  width: auto;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
}

/* 气泡行：左右排版 */
.bubble-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
}

.bubble-row.left {
  justify-content: flex-start;
}

.bubble-row.right {
  justify-content: flex-end;
}

/* 头像 */
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  background: #07c160;
}

.avatar-default-me {
  background: #576b95;
}

.avatar-crush {
  margin-right: 16rpx;
}

.avatar-me {
  margin-left: 16rpx;
  background: #576b95;
}

/* 气泡 */
.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-word;
  position: relative;
}

.bubble-crush {
  background: #ffffff;
  color: #1a1a1a;
}

.bubble-crush::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 24rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 8rpx 12rpx 8rpx 0;
  border-color: transparent #ffffff transparent transparent;
}

/* AI 建议卡片（右侧） */
.ai-card {
  max-width: 78%;
  background: #95ec69;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  position: relative;
}

.ai-card-error {
  background: #fff1f0;
  border: 1rpx solid #fa5151;
}

.ai-card-error::after {
  border-color: transparent transparent transparent #fff1f0;
}

.ai-card-initiate {
  background: #fff3d6;
}

.ai-card-initiate::after {
  border-color: transparent transparent transparent #fff3d6;
}

.intent-context {
  margin-bottom: 12rpx;
  padding: 8rpx 12rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  line-height: 1.4;
}

.error-block {
  padding: 16rpx 0;
  text-align: center;
}

.error-text {
  font-size: 26rpx;
  color: #fa5151;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.retry-btn {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: #fa5151;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.retry-btn:active {
  opacity: 0.8;
}

.ai-card::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 24rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 8rpx 0 8rpx 12rpx;
  border-color: transparent transparent transparent #95ec69;
}

.ai-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
  margin-bottom: 12rpx;
}

.ai-label {
  font-size: 22rpx;
  color: #4a7d3a;
  font-weight: 500;
}

.ai-style {
  font-size: 22rpx;
  color: #4a7d3a;
  opacity: 0.7;
}

.suggestion {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.suggestion:last-of-type {
  border-bottom: none;
}

.suggestion-text {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
  margin-right: 16rpx;
}

.suggestion-copy {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #4a7d3a;
  flex-shrink: 0;
}

.suggestion-copy:active {
  background: rgba(255, 255, 255, 0.9);
}

.more-btn {
  margin-top: 12rpx;
  padding: 12rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #4a7d3a;
}

.more-btn:active {
  background: rgba(255, 255, 255, 0.8);
}

/* 思考中动画 */
.thinking {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.thinking-mini {
  padding: 8rpx 0;
}

.dot {
  font-size: 40rpx;
  color: #4a7d3a;
  line-height: 0.5;
  margin-right: 4rpx;
  animation: blink 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

.thinking-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #4a7d3a;
}

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

/* 底部输入栏 */
.input-bar {
  background: #f7f7f7;
  border-top: 1rpx solid #e0e0e0;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
}

.initiate-entry {
  padding: 16rpx 20rpx;
  background: #fff8e6;
  border: 1rpx solid #ffe0a3;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #b9831b;
  text-align: center;
  margin-bottom: 16rpx;
}

.initiate-entry:active {
  background: #fff0c8;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input {
  flex: 1;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  min-height: 64rpx;
}

.send-btn {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.send-btn.active {
  background: #07c160;
  color: #ffffff;
}

.send-btn.disabled {
  background: #d9d9d9;
  color: #ffffff;
}

/* ============ 按压反馈（B） ============ */
.send-btn.active,
.style-pill,
.scenario-chip,
.modal-btn,
.suggestion-copy,
.more-btn,
.retry-btn,
.initiate-entry,
.avatar,
.bubble {
  transition: transform 0.15s ease, opacity 0.15s ease, background-color 0.15s ease;
}

.send-btn.active:active {
  transform: scale(0.96);
  background: #06ad56;
}

.style-pill:active,
.scenario-chip:active {
  transform: scale(0.95);
}

.modal-btn:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.suggestion-copy:active,
.more-btn:active,
.retry-btn:active {
  transform: scale(0.92);
  opacity: 0.8;
}

.initiate-entry:active {
  transform: scale(0.98);
}

.avatar:active {
  transform: scale(0.92);
  opacity: 0.85;
}

.style-row {
  margin-top: 16rpx;
  white-space: nowrap;
  height: 80rpx;
  width: 100%;
}

.style-row-empty {
  margin-top: 16rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fa5151;
  background: #fff;
  border-radius: 8rpx;
}

.style-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  vertical-align: middle;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease, border-color 0.2s ease;
}

.style-pill.selected {
  animation: pill-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes pill-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.style-pill .style-emoji {
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.style-pill.selected .style-emoji {
  transform: scale(1.2);
}

.style-pill.selected {
  border-color: #07c160;
  background: #e8f7ed;
}

.style-emoji {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.style-name {
  color: #1a1a1a;
}

.style-pill.selected .style-name {
  color: #07c160;
  font-weight: 500;
}

/* ============ 主动模式弹窗 ============ */
.modal-wrap {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.modal-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}

.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: #d9d9d9;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-section-label {
  font-size: 26rpx;
  color: #555;
  margin: 24rpx 0 16rpx;
}

.modal-section-hint {
  color: #999;
  font-size: 22rpx;
}

.scenarios {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.scenario-chip {
  flex: 0 0 auto;
  padding: 16rpx 24rpx;
  background: #f5f5f7;
  border: 2rpx solid transparent;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.scenario-chip.selected {
  background: #e8f7ed;
  border-color: #07c160;
}

.scenario-chip.selected .scenario-label {
  color: #07c160;
  font-weight: 500;
}

.scenario-emoji {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.scenario-label {
  color: #333;
}

.modal-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.modal-meta {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #888;
  text-align: right;
}

.modal-meta-strong {
  color: #07c160;
  font-weight: 500;
}

.modal-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin: 0;
}

.modal-btn-cancel {
  background: #f5f5f7 !important;
  color: #555 !important;
  border: none;
}

.modal-btn-confirm {
  background: #07c160 !important;
  color: #ffffff !important;
  border: none;
}

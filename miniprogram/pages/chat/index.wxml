<view class="page">

  <view class="skeleton-page" wx:if="{{loading}}">
    <view class="sk-bubble sk-left">
      <view class="sk-avatar"></view>
      <view class="sk-text sk-text-short"></view>
    </view>
    <view class="sk-bubble sk-right">
      <view class="sk-text sk-text-long"></view>
      <view class="sk-avatar"></view>
    </view>
    <view class="sk-bubble sk-left">
      <view class="sk-avatar"></view>
      <view class="sk-text sk-text-medium"></view>
    </view>
  </view>

  <view class="full-state" wx:elif="{{errorMsg}}">
    <view class="state-emoji">⚠️</view>
    <view class="state-text">{{errorMsg}}</view>
  </view>

  <block wx:else>
    <scroll-view
      class="msg-area"
      scroll-y
      scroll-into-view="{{scrollToView}}"
      scroll-with-animation
      enable-flex
    >
      <view class="empty-tip" wx:if="{{messages.length === 0}}">
        <view class="empty-illustration">
          <view class="empty-orb"></view>
          <view class="empty-emoji">💬</view>
        </view>
        <view class="empty-text">还没和 Ta 聊过</view>
        <view class="empty-sub-block">
          <view class="empty-sub-line">📥 把 Ta 发的消息粘下方</view>
          <view class="empty-sub-line">💡 或点黄色"主动找 Ta 聊"</view>
        </view>
        <view class="empty-hint">长按聊天气泡可以删除</view>
      </view>

      <view
        wx:for="{{messages}}"
        wx:key="_id"
        class="msg-round"
        id="msg-{{item._id}}"
        bindlongpress="onLongPressMessage"
        data-id="{{item._id}}"
      >
        <view class="time-mark" wx:if="{{item.timeMark}}">{{item.timeMark}}</view>

        <!-- 左侧 crush 气泡：仅在 reply 模式显示 -->
        <view class="bubble-row left" wx:if="{{item.type !== 'initiate'}}">
          <view class="avatar avatar-crush" bindtap="onTapCrushAvatar">
            <image src="{{conversation.crushAvatar}}" wx:if="{{conversation.crushAvatar}}" mode="aspectFill"></image>
            <view class="avatar-default" wx:else>{{conversation.crushNickname[0]}}</view>
          </view>
          <view class="bubble bubble-crush">
            <text>{{item.crushMessage}}</text>
          </view>
        </view>

        <view class="bubble-row right">
          <view class="ai-card {{item.error ? 'ai-card-error' : ''}} {{item.type === 'initiate' ? 'ai-card-initiate' : ''}}">
            <view class="ai-card-header">
              <text class="ai-label">{{item.typeLabel}}</text>
              <text class="ai-style">{{item.styleDisplay}}</text>
            </view>

            <view wx:if="{{item.type === 'initiate' && item.intent.context}}" class="intent-context">
              意图：{{item.intent.context}}
            </view>

            <view wx:if="{{item.loading}}" class="thinking">
              <text class="dot">•</text><text class="dot">•</text><text class="dot">•</text>
              <text class="thinking-text">思考中</text>
            </view>

            <view wx:elif="{{item.error}}" class="error-block">
              <view class="error-text">⚠️ {{item.error}}</view>
              <view class="retry-btn" data-id="{{item._id}}" bindtap="onRetry">点击重试</view>
            </view>

            <block wx:else>
              <view
                wx:for="{{item.suggestions}}"
                wx:for-item="sug"
                wx:for-index="sIdx"
                wx:key="sIdx"
                class="suggestion"
              >
                <text class="suggestion-text">{{sug}}</text>
                <view class="suggestion-copy" data-text="{{sug}}" catchtap="onTapCopy">复制</view>
              </view>

              <view
                wx:if="{{item.suggestions.length < 3 && !item.loadingMore}}"
                class="more-btn"
                data-id="{{item._id}}"
                catchtap="onTapMore"
              >
                {{item.moreError ? '⚠️ 失败，点击重试' : '再来 ' + (3 - item.suggestions.length) + ' 条'}}
              </view>

              <view wx:if="{{item.loadingMore}}" class="thinking thinking-mini">
                <text class="dot">•</text><text class="dot">•</text><text class="dot">•</text>
              </view>
            </block>
          </view>

          <view class="avatar avatar-me" bindtap="onTapMyAvatar">
            <image wx:if="{{me.avatar}}" src="{{me.avatar}}" mode="aspectFill"></image>
            <view wx:else class="avatar-default avatar-default-me">{{me.nickname[0] || '我'}}</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="input-bar">
      <!-- 主动入口 -->
      <view class="initiate-entry" bindtap="openInitiateModal">
        💡 想主动找 {{conversation.crushNickname}} 聊？
      </view>

      <view class="input-row">
        <input
          class="input"
          placeholder="或粘 crush 发来的消息..."
          value="{{inputText}}"
          bindinput="onInputChange"
          confirm-type="send"
          bindconfirm="onTapSend"
        />
        <view
          class="send-btn {{(inputText && selectedStyleId && !sending) ? 'active' : 'disabled'}}"
          bindtap="onTapSend"
        >
          {{sending ? '生成中...' : '发送'}}
        </view>
      </view>

      <scroll-view scroll-x class="style-row" wx:if="{{styles.length > 0}}">
        <view
          wx:for="{{styles}}"
          wx:key="id"
          class="style-pill {{selectedStyleId === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectStyle"
        >
          <text class="style-emoji">{{item.emoji}}</text>
          <text class="style-name">{{item.displayName}}</text>
        </view>
      </scroll-view>
      <view wx:else class="style-row-empty">
        ⚠️ 风格未加载（共 {{styles.length}} 条）。请确认 styles 表已建好、权限是"所有用户可读"
      </view>
    </view>
  </block>

  <!-- 主动模式弹窗 -->
  <view class="modal-wrap" wx:if="{{initiateModalVisible}}" bindtap="closeInitiateModal">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-handle"></view>
      <view class="modal-title">主动找 {{conversation.crushNickname}}</view>

      <view class="modal-section-label">选个场景</view>
      <view class="scenarios">
        <view
          wx:for="{{scenarios}}"
          wx:key="key"
          class="scenario-chip {{selectedScenario === item.key ? 'selected' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectScenario"
        >
          <text class="scenario-emoji">{{item.emoji}}</text>
          <text class="scenario-label">{{item.label}}</text>
        </view>
      </view>

      <view class="modal-section-label">
        具体想说什么？
        <text class="modal-section-hint">（"其他"必填，其他场景可空）</text>
      </view>
      <textarea
        class="modal-textarea"
        value="{{intentContext}}"
        bindinput="onIntentContextInput"
        placeholder="例如：周末想约去看《热辣滚烫》"
        maxlength="100"
        auto-height
      />

      <view class="modal-meta">
        将用风格：<text class="modal-meta-strong">{{selectedStyleDisplay}}</text>
      </view>

      <view class="modal-actions">
        <button class="modal-btn modal-btn-cancel" bindtap="closeInitiateModal">取消</button>
        <button class="modal-btn modal-btn-confirm" bindtap="onConfirmInitiate">生成开场白</button>
      </view>
    </view>
  </view>

</view>
